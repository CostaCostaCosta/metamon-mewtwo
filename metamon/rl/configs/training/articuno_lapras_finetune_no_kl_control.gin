import amago.agent
import metamon.rl.custom_agent

# Articuno ckpt36 -> Lapras target-team finetune control.
# Matched to the v3 local-reference runs except with no KL damping or static
# anchor loss. Use with --trainable_patterns actor traj_encoder.tformer.layers.9.

MetamonAMAGOExperiment.agent_type = @custom_agent.MetamonFinetuneAgent

agent.Agent.reward_multiplier = 5.0
agent.MultiTaskAgent.reward_multiplier = 5.0

agent.Agent.tau = .006
agent.MultiTaskAgent.tau = .006

agent.Agent.num_actions_for_value_in_critic_loss = 1
agent.MultiTaskAgent.num_actions_for_value_in_critic_loss = 4

agent.Agent.num_actions_for_value_in_actor_loss = 1
agent.MultiTaskAgent.num_actions_for_value_in_actor_loss = 4

agent.Agent.online_coeff = 0.0
agent.MultiTaskAgent.online_coeff = 0.0
agent.Agent.offline_coeff = 1.0
agent.MultiTaskAgent.offline_coeff = 1.0

agent.Agent.fbc_filter_func = @custom_agent.ISAdvantageFilter()
agent.MultiTaskAgent.fbc_filter_func = @custom_agent.ISAdvantageFilter()
custom_agent.ISAdvantageFilter.beta = 1.25
custom_agent.ISAdvantageFilter.clip_weights_low = 1e-4
custom_agent.ISAdvantageFilter.clip_weights_high = 20.
custom_agent.ISAdvantageFilter.seq_p_low = 0.25
custom_agent.ISAdvantageFilter.seq_p_full = 0.75
custom_agent.ISAdvantageFilter.seq_floor = 0.25
custom_agent.ISAdvantageFilter.seq_floor_warmup_steps = 8000
custom_agent.ISAdvantageFilter.seq_buffer_size = 10000
custom_agent.ISAdvantageFilter.seq_warmup = 200

custom_agent.MetamonFinetuneAgent.bc_coeff = 0.0
custom_agent.MetamonFinetuneAgent.kl_anchor_coeff = 0.0
custom_agent.MetamonFinetuneAgent.epoch_start_kl_coeff = 0.0
custom_agent.MetamonFinetuneAgent.tortoise_tau = 0.005
custom_agent.MetamonFinetuneAgent.use_tortoise_for_inference = False
custom_agent.MetamonFinetuneAgent.use_is_correction = False

MetamonAMAGOExperiment.l2_coeff = 1e-4
MetamonAMAGOExperiment.learning_rate = 3e-5
MetamonAMAGOExperiment.grad_clip = 1.0
MetamonAMAGOExperiment.grad_clip_final = None
agent.Agent.critic_loss_weight = 7.5
agent.MultiTaskAgent.critic_loss_weight = 7.5
MetamonAMAGOExperiment.lr_warmup_steps = 3000
MetamonAMAGOExperiment.lr_decay_steps = 0

MetamonAMAGOExperiment.use_dynamic_damping = False
MetamonAMAGOExperiment.log_policy_health_metrics = True

# Save an EMA head snapshot for matched raw-vs-EMA evaluation. This does not
# alter the raw policy update; it only affects validation when ema_eval_only is
# active and gives the evaluator a comparable smoothed checkpoint.
MetamonAMAGOExperiment.use_ema = True
MetamonAMAGOExperiment.ema_decay = 0.999
MetamonAMAGOExperiment.ema_update_interval = 1
MetamonAMAGOExperiment.ema_warmup_steps = 0
MetamonAMAGOExperiment.ema_eval_only = True
