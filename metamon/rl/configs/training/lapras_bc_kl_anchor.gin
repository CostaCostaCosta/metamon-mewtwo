import amago.agent
import metamon.rl.custom_agent

# Conservative Lapras specialist finetune:
# - behavior cloning style offline loss (fake filter, no critic pressure)
# - KL anchor to the loaded Articuno checkpoint
# - mild per-epoch KL damping against the epoch-start policy snapshot
# - tortoise/EMA weights for validation and checkpoint H2H eval

MetamonAMAGOExperiment.agent_type = @custom_agent.MetamonFinetuneAgent

agent.Agent.reward_multiplier = 1.0
agent.MultiTaskAgent.reward_multiplier = 1.0

agent.Agent.online_coeff = 0.0
agent.MultiTaskAgent.online_coeff = 0.0

agent.Agent.offline_coeff = 1.0
agent.MultiTaskAgent.offline_coeff = 1.0

amago.agent.Agent.fake_filter = True
amago.agent.MultiTaskAgent.fake_filter = True

custom_agent.MetamonFinetuneAgent.bc_coeff = 0.0
custom_agent.MetamonFinetuneAgent.kl_anchor_coeff = 0.3
custom_agent.MetamonFinetuneAgent.epoch_start_kl_coeff = 0.1
custom_agent.MetamonFinetuneAgent.tortoise_tau = 0.005
custom_agent.MetamonFinetuneAgent.use_tortoise_for_inference = True
custom_agent.MetamonFinetuneAgent.use_is_correction = False

MetamonAMAGOExperiment.l2_coeff = 1e-4
MetamonAMAGOExperiment.learning_rate = 1e-5
MetamonAMAGOExperiment.grad_clip = 1.0
agent.Agent.critic_loss_weight = 0.0
agent.MultiTaskAgent.critic_loss_weight = 0.0
MetamonAMAGOExperiment.lr_warmup_steps = 1000
