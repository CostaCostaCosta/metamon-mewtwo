# Articuno ckpt36 -> Lapras target-team finetune with v3 local-reference KL.
# Same controller recipe as local32, with a 24-step reference/update window and
# a slightly higher target KL for the second corrected matrix.

include 'metamon/rl/configs/training/articuno_lapras_finetune_v3_local32.gin'

MetamonAMAGOExperiment.dd_kl_reference_update_interval = 24
MetamonAMAGOExperiment.dd_adapt_interval = 24
MetamonAMAGOExperiment.target_kl_per_step = 0.04
MetamonAMAGOExperiment.target_kl_final = 0.04
